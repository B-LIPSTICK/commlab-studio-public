{
  "name": "commlab-studio",
  "version": "0.1.7",
  "description": "通信原理虚拟仿真实验 · 教学助手",
  "main": "app/main.js",
  "author": "B-LIPSTICK",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-win.ps1",
    "dist:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-win.ps1 -Portable",
    "check:js": "node --check app/main.js && node --check app/preload.js && node --check app/renderer/app.js && node --check app/updater.js",
    "dist:public": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-win.ps1 -PublicRelease -Portable",
    "check:public": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-win.ps1 -CheckPublicRelease",
    "smoke:packaged": "node tools/smoke-packaged.js"
  },
  "dependencies": {
    "marked": "^14.1.3",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.blipstick.commlabstudio",
    "productName": "CommLab Studio",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "app/**/*",
      "data/**/*",
      "templates/**/*",
      "build/icon.png",
      "package.json",
      "!data/scripts/**",
      "!data/**/*.m",
      "!data/**/*.octave",
      "!data/**/*.png",
      "!data/**/*.jpg",
      "!data/**/*.jpeg",
      "!data/**/*.gif",
      "!data/**/*.webp"
    ],
    "extraMetadata": {
      "main": "app/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "CommLabStudio-${version}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CommLab Studio"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/B-LIPSTICK/commlab-studio-public.git"
  },
  "homepage": "https://github.com/B-LIPSTICK/commlab-studio-public#readme"
}
